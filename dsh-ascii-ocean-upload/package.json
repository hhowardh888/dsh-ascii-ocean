{
  "name": "@local/ascii-sharks",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "A real-time ASCII ocean behind the DeepSeek Harness conversation, with a feathered reading area and in-app settings.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "esbuild build/entry.js --bundle --format=iife --platform=browser --target=chrome110 --charset=utf8 --outfile=client.js",
    "check": "node --check client.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
